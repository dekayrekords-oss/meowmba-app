<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Debug-only. Never merged into release. Lets adb set keys / wake word. -->
    <application>
        <receiver
            android:name=".core.debug.DebugConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.debug.CONFIG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

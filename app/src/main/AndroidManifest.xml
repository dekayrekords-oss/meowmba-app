<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Navigation: needed to rank nearby places by distance from the user. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Android 11+ package visibility. Without this, queryIntentActivities and
      getLaunchIntentForPackage see almost nothing and "open Spotify" fails
      with a misleading "no installed app matches" result. Declaring the
      launcher intent (rather than QUERY_ALL_PACKAGES) keeps the app off
      Play's sensitive-permission review path.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- MetaMemory glasses companion (shared memories / runtime) -->
        <package android:name="com.meow.metamemory" />
        <!-- Meow Inventory. Without this, API 30+ package visibility hides the app
             entirely: bindService fails and getLaunchIntentForPackage returns null, which
             looks exactly like "the inventory app is not installed". -->
        <package android:name="com.meow.inventory" />
        <intent>
            <action android:name="com.meow.inventory.action.INVENTORY_BRIDGE" />
        </intent>
        <!-- Navigation: without these, API 30+ package visibility makes the maps
             intent silently unresolvable. -->
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- Speech: without an explicit RecognitionService query, API 30+ package
             visibility hides most recognizers from queryIntentServices() and the
             app binds whatever scrap it can see (observed: Home Assistant's
             service, erroring 5/9). Android System Intelligence is the one we
             actually want. -->
        <package android:name="com.google.android.as" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meowmba">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Meowmba"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>

        <!-- Background wake-phrase listening (Phase 2.5). Started only from
             MainActivity.onPause when the user has explicitly enabled it. -->
        <service
            android:name=".core.audio.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Background model downloads. Started when user taps Download
             on a catalog model; runs even when the app is in the background
             so large models don't need the screen on. -->
        <service
            android:name=".core.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shared model runtime + memory for MetaMemory glasses app -->
        <service
            android:name=".bridge.MeowmbaRuntimeService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.example.meowmba.action.RUNTIME_BRIDGE" />
            </intent-filter>
        </service>
    </application>

</manifest>